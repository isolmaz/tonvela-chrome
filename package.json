{
  "name": "tonvela-chrome",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint extension tests tools eslint.config.js",
    "check": "npm run lint && npm test",
    "test:browser": "node tools/integration-test.mjs",
    "test:voice": "node tools/voice-test.mjs",
    "package": "python tools/package.py",
    "assets": "node tools/assets.mjs",
    "media": "node tools/media.mjs",
    "verify": "node tools/pre-push.mjs --all",
    "prepare": "node tools/pre-push.mjs --install"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "playwright": "1.62.1",
    "sharp": "0.35.4"
  },
  "license": "MIT"
}
